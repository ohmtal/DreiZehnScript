-- -----------------------------------------------------------------------------
-- BaseFlux13 Main
-- -----------------------------------------------------------------------------
define SDLK_ESCAPE 0x0000001b
define SDLK_PAGEDOWN               0x4000004e
define SDLK_RIGHT                  0x4000004f
define SDLK_LEFT                   0x40000050
define SDLK_DOWN                   0x40000051
define SDLK_UP                     0x40000052

define LIGHTGRAY  Vector::new 200 200 200 255    # Light Gray
define GRAY       Vector::new 130 130 130 255    # Gray
define DARKGRAY   Vector::new 80 80 80 255       # Dark Gray
define YELLOW     Vector::new 253 249 0 255      # Yellow
define GOLD       Vector::new 255 203 0 255      # Gold
define ORANGE     Vector::new 255 161 0 255      # Orange
define PINK       Vector::new 255 109 194 255    # Pink
define RED        Vector::new 230 41 55 255      # Red
define MAROON     Vector::new 190 33 55 255      # Maroon
define GREEN      Vector::new 0 228 48 255       # Green
define LIME       Vector::new 0 158 47 255       # Lime
define DARKGREEN  Vector::new 0 117 44 255       # Dark Green
define SKYBLUE    Vector::new 102 191 255 255    # Sky Blue
define BLUE       Vector::new 0 121 241 255      # Blue
define DARKBLUE   Vector::new 0 82 172 255       # Dark Blue
define PURPLE     Vector::new 200 122 255 255    # Purple
define VIOLET     Vector::new 135 60 190 255     # Violet
define DARKPURPLE Vector::new 112 31 126 255     # Dark Purple
define BEIGE      Vector::new 211 176 131 255    # Beige
define BROWN      Vector::new 127 106 79 255     # Brown
define DARKBROWN  Vector::new 76 63 47 255       # Dark Brown

global Rects = 0
global Count = 250 # better for debug
-- -----------------------------------------------------------------------------
-- To set parameters before it open the window
fn flux::Load
--     flux::maxfps 0
end
-- -----------------------------------------------------------------------------
fn flux::Init
    template = Array::new "point" => 0, "color" => 0, "fill" => 0
    Rects = Vector::new
    Rects->fill Count template

    forEach item Rects
        item["point"] = Vector::new 0 0 0 0;
        item["point"][2] = 5 + math::randomf * 30
        item["point"][3] = 5 + math::randomf * 20
        item["point"][0] = math::randomf * (800.0 - item["point"][2])
        item["point"][1] = math::randomf * (450.0 - item["point"][3])

        item["color"] = Vector::new 255 255 255 255
        item["color"][0] = math::random 50 200
        item["color"][1] = math::random 50 200
        item["color"][2] = math::random 50 200

        item["fill"] =  math::random 0 1

    end

end
-- -----------------------------------------------------------------------------
fn flux::Render
    forEach item Rects
        flux::DrawRect item["point"] item["color"] item["fill"]
    end

    flux::DrawFPS 10.0 10.0 3.0
end
-- -----------------------------------------------------------------------------
fn flux::ShutDown
end
-- -----------------------------------------------------------------------------
fn flux::OnKey keycode isDown mod
    if isDown
        if keycode == SDLK_ESCAPE
            flux::Close
        end
    end
end
-- -----------------------------------------------------------------------------
fn flux::OnMouse x y button isDown
end
