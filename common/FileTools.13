global doReload = false
fn postRL; doReload = false if sys::args.argc > 1; run sys::args.argv_1 ;; end
fn rl; doReload = true;;
-- -----------------------------------------------------------------------------
fn testLoad
    if sys::args.argc < 2; error "no script param for test avaiable :P";;
    filename = sys::args.argv_1
    ft = FileTool::new filename
    ft->load
    print ">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>"
    print ft.content
    print "<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<"
end
-- -----------------------------------------------------------------------------
fn testSave
    ft = FileTool::new "testFileTool.txt"
    ft.content = "Gude alder babsack!\n"
    if (ft->save) print "save success!"
    else error "save failed!"
    end
end
