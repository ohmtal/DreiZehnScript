import File
import String
-- -----------------------------------------------------------------------------
fn FileTool::load this
    if this.filename == ""; return 0;;
    fs = FileStream::open this.filename "r"
    if (!fs); return 0;;
    this.content = "";
    while true
        buff =  fs->read 1024
        if (buff == 0) break;;
        print buff
        this.content += buff
    end
    fs->close
    return true
end
-- -----------------------------------------------------------------------------
fn FileTool::save this
    if this.filename == ""; return 0;;
    if this.content == ""; return 0;;
    fs = FileStream::open this.filename "w"
    if (!fs); return 0;;
    result = fs->write this.content
    fs->close
    return result
end
-- -----------------------------------------------------------------------------
fn FileTool::new filename
    result = Object::new
    result->setClassName "FileTool"
    result.filename = filename
    return result
end

