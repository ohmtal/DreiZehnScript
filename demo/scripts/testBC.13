-- Byte Code testing

# ------------------------------------------------------------------------------
include "common/FileTools.13" true
fn loadSource fileName
    ft = FileTool::new (str::concat "scripts/" fileName);
    if !ft; return "";;
    if !ft->load; return "";;
    return ft.content
end
# ------------------------------------------------------------------------------
fn niceLine str
    space = 80 - 2 - (str::strlen str)
    if space < 2; print str; return;;
    halfSpace = space / 2
    forRange i halfSpace; printraw "─";;
    printraw " " str " "
    forRange i halfSpace; printraw "─";;
    print ""
end
