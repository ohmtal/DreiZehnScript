# Benchmark-Test for DreiZehn Script (0.8)
import Core
import Math

define JLOOPS 25
define ILOOPS 1000000
define HLOOPS ILOOPS / 2

localX = 0.0

forRange j JLOOPS
    forRange i ILOOPS
        localX++
    end
    print  "SUM (++) IS: " localX

    forRange i ILOOPS
        localX--
    end
    print  "SUM (--) IS: " localX

    localX = 66
    print  "set Sum to 66 == " (localX * 1)

    forRange i ILOOPS
        localX *= (i + 1)
        localX /= (i + 1)
    end
    print  "SUM (*/ %i+1) IS: " localX

    ran = 0.0
    forRange i HLOOPS
        ran = math::randomf * i
        localX -= ran
        localX += ran
    end
    print  "last ran" ran
    print  "SUM (rand +-) IS: " localX
end

localX = localX - 33.0
print "---------------------"
print "---------------------"
print  "Final sum should be 33.0 == " localX
print "---------------------"
print "---------------------"
