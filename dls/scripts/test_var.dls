# Benchmark-Test Dirty little Script

define JLOOPS 25
define ILOOPS 1000000
define HLOOPS 500000

globalX = 0.0
j = 0;

while j < JLOOPS
    i = 0; while i <  ILOOPS
        globalX = globalX + 1
        i = i + 1
    end
    print  "SUM (++) IS: " globalX

    i = 0; while i < ILOOPS
        globalX = globalX - 1
        i = i + 1
    end
    print  "SUM (--) IS: " globalX

    globalX = 66
    print  "set Sum to 66 == " (globalX * 1)

    i = 0; while i < ILOOPS
        globalX = globalX * (i + 1)
        globalX = globalX / (i + 1)
        i = i + 1
    end
    print  "SUM (*/ %i+1) IS: " globalX

    ran = 0.0
    i = 0; while i <  HLOOPS
        ran = math::randomf * i
        globalX = globalX - ran
        globalX = globalX + ran
        i = i + 1
    end
    print  "last ran" ran
    print  "SUM (rand +-) IS: " globalX
    j = j + 1
end

globalX = globalX - 33.0
print "---------------------"
print "---------------------"
print  "Final sum should be 33.0 == " globalX
print "---------------------"
print "---------------------"
