// -----------------------------------------------------------------------------
//  DreiZehn MiniFB
// -----------------------------------------------------------------------------
define WINDOW_W     = 320
define WINDOW_H     = 160
define WINDOW_SCALE = 3.5
define FONT_SCALE   = 2.0
define DEG2RAD      = math::pi / 180.0f

miniFB = 0
global Game   = 0
Audio  = 0

// -----------------------------------------------------------------------------
function MyFB::initPlasmaPallete this
    pallete = Vector::new;
    pallete->fill 512 0
    inc = 90.0f / 64.0f;
    forRange c 64
        col = (255.0f * (math::sin c * inc * DEG2RAD)) + 0.5f
        pallete[64 * 0 + c] = MiniFB::color col,     0,       0
        pallete[64 * 1 + c] = MiniFB::color 255,     col,     0
        pallete[64 * 2 + c] = MiniFB::color 255-col, 255,     0
        pallete[64 * 3 + c] = MiniFB::color 0,       255,     col
        pallete[64 * 4 + c] = MiniFB::color 0,       255-col, 255
        pallete[64 * 5 + c] = MiniFB::color col,     0,       255
        pallete[64 * 6 + c] = MiniFB::color 255,     0,       255-col
        pallete[64 * 7 + c] = MiniFB::color 255-col, 0,       0
    end
    this.pallete = pallete
end
// -----------------------------------------------------------------------------
// from miniFB Demo :
function MyFB::plasma this w h
    if !this.pallete; this->initPlasmaPallete;;
    time_x = math::sin this.plasmaTime * DEG2RAD
    time_y = math::cos this.plasmaTime * DEG2RAD
    i = 0
    forRange y h
        dy = math::cos y * time_y * DEG2RAD
        forRange x w
            dx = math::sin x * time_x * DEG2RAD
            index = (2.0f + dx + dy) * 0.25f * 511.0f
            this->pixel i++ this.pallete[index]
        end
    end
    this.plasmaTime += 0.03f;
end
// -----------------------------------------------------------------------------
function MyFB::fillSky this w h fontscale
    this->rect 0 0 w h 0x00050515
    r = h / 8
    this->circle (w - w / 4 - 1) (h / 4 - 1) r 0x00646464
    this->circle (w - w / 4) (h / 4 ) r 0x00fefecd
    this->circle (w - w / 4 + 15) (h / 4 - 10) (h / 8) 0x00050515

    forRange i 40
        x = math::random 10 (w - 10)
        y = math::random 10 (h - 10)

        c = MiniFB::color (math::random 150 255) (math::random 150 255) (math::random 150 255)

        this->line (x - 2) y (x + 2) y c
        this->line x (y - 2) x (y + 2) c
    end

    this->text  9  9 "Night Sky" fontscale * 2 0x00646464
    this->text 10 10 "Night Sky" fontscale * 2 0x000A0Aff
end
// -----------------------------------------------------------------------------
// MiniAudio Test
define SOUND_RATE_8K   1.0
define SOUND_RATE_12K  12000.0 / 8000.0
// -----------------------------------------------------------------------------
fn Audio::laser this
    this.laser_counter = 0
    this.laserActive = true;
end

fn Audio::explo this
    this.explo_counter = 0
    this.exploActive = true
end

fn Audio::process this
    n = this->getAvail
    if n > 0

        forRange i n
            this.counter++

            float_value = 0.0

            -- music

            if Game.gameOver
                t = int::cast (this.counter * SOUND_RATE_12K)
                music_sample = (((t & t ^ t >> 6 | t * 3) - t  ) & 255) * 0.2
            else
                t = int::cast (this.counter * SOUND_RATE_8K)
                 music_sample  =  (t*(3+(1^t>>10&5))*(5+(3&t>>14))>>(t>>8&3) & 255) * 0.3
            end
            float_value += music_sample / 255.0



            if this.laserActive
                this.laser_counter++
                lt = int::cast (this.laser_counter * SOUND_RATE_8K)
--                 laser_sample = ((lt * (64 - (lt >> 7 & 63)) & 128) >> (lt >> 10)) ;
--                 laser_sample = ((lt * (32 - (lt >> 7 & 31)) & 255) >> (lt >> 8)) ;
                laser_sample = ((lt * (16 - (lt >> 2 ))) & 64) >> (lt >> 8) ;
                float_value += laser_sample / 255.0 ;
                if this.laser_counter > 1584
                    this.laserActive = false
                end
            end

            if this.exploActive
                this.explo_counter++
                lt = int::cast (this.explo_counter * SOUND_RATE_8K)
                explo_sample = ((lt * (lt >> 7 | lt >> 9)) & 128) & (255 >> (lt >> 11));
                float_value += explo_sample / 255.0;

                if this.explo_counter > 2048
                    this.exploActive = false
                end
            end
            -- mix
            this->set i (float_value  * this.vol)
        end
        this->write n
    end
end

// -----------------------------------------------------------------------------
// Main
// -----------------------------------------------------------------------------
backcolor = 0x000CDD

miniFB = MiniFB::new "MiniFB DreiZehn" WINDOW_W WINDOW_H WINDOW_SCALE
miniFB->setClassName "MyFB"
miniFB.plasmaTime = 0.0;
miniFB.dirty = false;
miniFB.pallete = 0;
miniFB->clear backcolor
miniFB->fillSky WINDOW_W (WINDOW_H - 20) FONT_SCALE



-- Dummy Game --
Game = Object::new
Game.gameOver = true

-- Audio --
# 512 buffer to have fast switches.
Audio  = MiniAudioCallback::new 8000 1 512
Audio->setClassName "Audio"
Audio.vol   = 0.5
Audio.counter = 0
Audio.laserActive = false
Audio.laser_counter = 0
Audio.exploActive = false
Audio.explo_counter = 0




while miniFB->loop == MFB_STATE_OK

   if miniFB->getMouseDown 1
       Audio->explo
   end
   if miniFB->getMouseDown 2
       Audio->laser
   end

   if miniFB->isKeyDown MFB_KB_KEY_SPACE
        # miniFB->text (WINDOW_W - FONT_SCALE * 5 - 20) (WINDOW_H - 15) "*" FONT_SCALE COLOR_GREEN
        miniFB->plasma WINDOW_W WINDOW_H
        Game.gameOver = false;
        miniFB.dirty = true;
   elif miniFB.dirty == true
        miniFB->fillSky WINDOW_W (WINDOW_H - 20) FONT_SCALE
        Game.gameOver = true;
        miniFB.dirty = false;
   else
       miniFB->rect 0 (WINDOW_H - 20) WINDOW_W 20 COLOR_BLACK
       str =  str::concat "mouse: x:" (miniFB->getMouseX) ", y:" (miniFB->getMouseY) ", down:" miniFB->getMouseDown
       miniFB->text 20 (WINDOW_H - 16) str FONT_SCALE COLOR_DARKGRAY
       miniFB->text 21 (WINDOW_H - 15) str FONT_SCALE COLOR_WHITE
   end

   Audio->process

  if !core::breath; break;;
end

print "finished...."
miniFB->close
miniFB = 0
