-- DreiZehn Fenster Demo

fenster = Fenster::new "DreiZehn Fenster" 320 240 2


print fenster
backcolor = 0x000CDD
fenster->clear backcolor
fenster->line 0 210 320 210 0x00004400
fenster->text 20 20 "Hello Fenster!" 4 0xFFFFFF

pb = PixelBuffer::new 8 8
pb->circle 4 4 4 COLOR_RED
pb->print

circle = Array::new 0 0 0 0 0xffff0000 0 0 0 0 0 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0 0 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0 0 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0xffff0000 0

while fenster->loop
    -- ESC
   if fenster->isKeyDown 27
       break
   end
   fenster->rect 0 210 320 30 COLOR_DARKGRAY
   fenster->text 20 220 (str::concat "mouse: x:" fenster.mouseX ", y:" fenster.mouseY ", down:" fenster.mouseDown) 2 0xFFFFFF



   if !core::breath; break;;
end

fenster->close
fenster = 0
core::gc

