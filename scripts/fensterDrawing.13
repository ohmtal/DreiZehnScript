W = 320
H = 200
fenster = Fenster::new "DreiZehn Fenster Drawing Demo" W H


-- -----------------------------------------------------------------------------
fn fillHouse
    -- Draw :)
    fenster->rect 0 0 W H 0x00333333
    fenster->rect (W / 4) (H / 2) (W / 2) (H / 3) COLOR_RED
    fenster->rect (W / 2) (H / 2 + H / 12) (W / 6) (H / 3 - H / 12) COLOR_BLUE
    fenster->circle (W / 2 - W / 8) (H / 2 + H / 6) (W / 20) COLOR_WHITE
    fenster->line (W / 4 - 25) (H / 2) ( W / 2 ) ( H / 4 ) 0x0000ffff
    fenster->line (W - W / 4 + 25) (H / 2) (W / 2) (H / 4) 0x0000ffff
    fenster->line (W - W / 4 + 25) (H / 2) (W / 4 - 25) (H / 2) 0x0000ffff
    fenster->fill (W / 2) (H / 3) 0x00333333 0x00ff00ff
    fenster->text 10 10 "House" 6 0x00ffffff
end

-- -----------------------------------------------------------------------------
fn fillRandom
    forRange col W
        forRange row H
           c = Fenster::color (math::random 0 255) (math::random 0 255) (math::random 0 255)
           fenster->setPixel col row c
        end
    end
end

-- -----------------------------------------------------------------------------
fn fillSky
    fenster->rect 0 0 W H 0x00050515

    fenster->circle (W - W / 4) (H / 4) (H / 8) 0x00fefecd
    fenster->circle (W - W / 4 + 15) (H / 4 - 10) (H / 8) 0x00050515

    forRange i 40
        x = math::random 10 (W - 10)
        y = math::random 10 (H - 10)

        c = Fenster::color 255 255 (math::random 150 255)

        fenster->line (x - 2) y (x + 2) y c
        fenster->line x (y - 2) x (y + 2) c
    end

    fenster->text 10 10 "Night Sky" 6 0x00ffffff
end

-- -----------------------------------------------------------------------------
fn fillTunnel
    fenster->rect 0 0 W H 0x00000000

    centerX = W / 2
    centerY = H / 2

    forRange step 12
        radius = (H / 2) - (step * (H / 24))

        greenIntensity = 255 - (step * 20)
        c = Fenster::color 0 greenIntensity 0

        fenster->circle centerX centerY radius c
    end

    fenster->line 0 centerY W centerY 0x00004400
    fenster->line centerX 0 centerX H 0x00004400

    fenster->text 10 10 "Radar Sweep" 6 0x0000ff00
end
-- -----------------------------------------------------------------------------
fn fillGradient
    forRange col W
        forRange row H
            r = (col * 255) / W
            g = (row * 255) / H
            b = 128

            c = Fenster::color r g b
            fenster->setPixel col row c
        end
    end

    fenster->text 10 10 "RGB Gradient" 6 0x00ffffff
end

-- -----------------------------------------------------------------------------
-- Main
-- -----------------------------------------------------------------------------

-- fillHouse
-- fillGradient
-- fillTunnel
fillSky

-- Wait for escape
spaceWasUp = true
while fenster->loop
   if fenster->isKeyDown KEY_SPACE
       if spaceWasUp
            print "FILL RANDOM"
            ran = math::random 0 4
            if (ran == 0) fillRandom end
            if (ran == 1) fillHouse end
            if (ran == 2) fillGradient end
            if (ran == 3) fillTunnel end
            if (ran == 4) fillSky end
        end
        spaceWasUp = false
    else
        spaceWasUp = true
   end
    -- ESC
   if fenster->isKeyDown KEY_ESC
       print "BREAK!"
       break
   end
   loopi++
end

fenster->close
fenster = 0
core::gc
