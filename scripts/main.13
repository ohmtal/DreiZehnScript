# ------------------------------------------------------------------------------
#   DreiZehn Module Loader - Finit State Machine
# ------------------------------------------------------------------------------
# Every Module need the functions:
#   - ModuleCreate
#   - ModuleLoop
#   - ModuleDelete
# ------------------------------------------------------------------------------
import All

-- Avail Modules in subfolder modules:
loader::Modules = Vector::new "FensterShooter" "Fenster" "RayFirst"
loader::ModuleIndex = -1
loader::ModuleName = ""

-- inital setup the call back functions,
-- so it can be overridden: when the script is parsed it lookup registered
-- functions. If none found it's set as an variable type. So we need to tell
-- there parser we have this function. The "run" loader override them later.
-- So they are basically "virual":
fn ModuleCreate end
fn ModuleLoop end
fn ModuleDelete end

# ------------------------------------------------------------------------------
-- since i had the namespace object call not in place when i designed this
-- script, the following functions are static.
# ------------------------------------------------------------------------------
fn loader::Load moduleIndex
    if moduleIndex < 0 || moduleIndex >= loader::Modules->size
        print "Loader Error: moduleIndex" moduleIndex "out of bounds!"
        return false
    end

    if loader::ModuleIndex >= 0
        ModuleDelete
    end

    loader::ModuleIndex = -1
    loader::ModuleName = loader::Modules->at moduleIndex
    runRes = run str::format "scripts/modules/%s.13" loader::ModuleName
    if (!runRes)
        print "Loader Error: unable to load module" loader::ModuleName
        return false
    end

    if !ModuleCreate
        print "Loader Error: failed to CreateMod:" loader::ModuleName
        return false
    end

    loader::ModuleIndex = moduleIndex
    return true
end
# ------------------------------------------------------------------------------
fn loader::MainLoop
    while core::breath
        if loader::ModuleIndex >= 0
            if ( !ModuleLoop )
                 ModuleDelete
                 loader::ModuleIndex = -1
            end
        else
            core::sleep 16
        end
    end
end
# ------------------------------------------------------------------------------

loader::Load 0
loader::MainLoop
if loader::ModuleIndex >= 0
    ModuleDelete
    loader::ModuleIndex = -1
    loader::ModuleName = 0
end
loader::Modules = 0         # release the vector object
