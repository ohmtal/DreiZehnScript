-- -----------------------------------------------------------------------------
--     DreiZehn Fenster Shooter Module Demo
--
--     A simple shooter with objects:
--     - Player { float x, y, w, h speed}
--     - Bullet { float x, y, w, h, speed; int active; }
--     - Enemy  { float x, y, w, h, color, speed; bool active; }
--     - Star { float x, y, color, speed; }
--
--     - Game { bool gameOver; int intscore, hiScore; }
--
-- -----------------------------------------------------------------------------
-- define global variables
-- -----------------------------------------------------------------------------

-- consts
title = "DreiZehn Fenster Shooter"
WIDTH  = 320
HEIGHT = 200
SCALE  = 2.4
GAMEWIDTH  = 320
GAMEHEIGHT = 180 # rest is for gui ;)
backcolor = 0x050510
soundRate8k  = 8000.0 / 44100.0
soundRate12k = 12000.0 / 44100.0

-- Objects
Fenster = 0     # The Fenster Object
Game    = 0     # The Game Object
Player  = 0     # Object
Bullets = 0     # Vector of Bullet Object
Enemies = 0     # Vector of Enemy Object
Stars   = 0     # Vector of Stars

--- Graphics
Ship     = 0     # TGA ship :)
Boulders = 0     # TGA boulder Vector :)

-- Sound
Audio    = 0     # FensterAudio Object

loopCounter = 0 # a simple counter




-- more consts
enemyCount  = 20
starCount   = 30

-- -----------------------------------------------------------------------------
fn doesCollide objA objB
    if not objA.active or not objB.active; return false; end

    if (objA.x > objB.x + objB.w or \
        objA.x + objA.w < objB.x or \
        objA.y > objB.y + objB.h or \
        objA.y + objA.h < objB.y)
        return false
    end

    return true
end
-- -----------------------------------------------------------------------------
--      Star Script-Methods

fn Star::init this initial
    this.x = math::randomf * GAMEWIDTH
    this.y = initial ? math::randomf * GAMEHEIGHT : 0
    this.speed = 0.40 + math::randomf * 1.5
    this.color = (this.speed > 1.2) ? 0xFFFFFF : 0x888888
end

fn Star::process this
    this.y += this.speed
    if this.y > GAMEHEIGHT
        this->init false
    end
    Fenster->setPixel this.x this.y this.color
end
-- -----------------------------------------------------------------------------
--      Enemy Script-Methods
fn Enemy::init this
    this.w = 16
    this.h = 16
    this->spawn
    this.active = false
end

fn Enemy::spawn this
    this.x = math::randomf * (GAMEWIDTH - this.w)
    this.y = 0
    this.speed = 0.5 + math::randomf * 1.0
    this.color = (this.speed > 1.0) ? COLOR_RED : 0x884444
    this.active = true
    id = math::random 0 (Boulders->size - 1)
    this.boulderId = int::cast id
end

fn Enemy::process this
    if (not this.active) or Game.gameOver return;;

    this.y += this.speed
    if (this.y > GAMEHEIGHT + 40)
        this.active = false
    end

    if doesCollide this Player
        Audio->explo
        Game->gameOver
        return
    end

--     b = Boulders->at this.boulderId
--     Fenster->drawBuffer this.x this.y b
    Fenster->drawBuffer this.x this.y Boulders[this.boulderId]

end

-- -----------------------------------------------------------------------------
-- Bullets
fn Bullet::spawn this x y isPlayer
    this.x = x
    this.y = y
    this.w = 2
    this.h = 4
    this.isPlayer = isPlayer
    this.speed = isPlayer ? 2.0 : 1.0
    this.color = isPlayer ? COLOR_YELLOW : COLOR_RED
    this.active = true
end

fn Bullet::process this
    if not this.active return;;
    if this.isPlayer
        this.y -= this.speed
        if this.y < 0
            this.active = false
        end
        forRange i enemyCount
            enemy = Enemies->at i
            if (doesCollide this enemy )
                Game.score += 10
                enemy.active = false
                this.active = false
                Audio->explo
                return
            end
        end
    else
        this.y += this.speed
        if (this.y > GAMEHEIGHT)
            this.active = false
        end
        -- FIXME collision
    end

    Fenster->rect this.x this.y this.w this.h this.color
end

-- -----------------------------------------------------------------------------
--      Player Script-Methods

fn Player::init this
    this.w = 16
    this.h = 16
    this.x = GAMEWIDTH / 2.0
    this.y = GAMEHEIGHT - this.h - 5
    this.speed = 1.0
    this.shootDelay = 300
    this.lastshoot = 0
    this.releasedSpace = true
    this.active = true
end

fn Player::process this
    if (Game.gameOver) return;;


    Fenster->drawBuffer this.x this.y Ship

    if (Fenster->isKeyDown KEY_LEFT)
        this.x = math::max 0 (this.x - this.speed)
    end
    if (Fenster->isKeyDown KEY_RIGHT)
        this.x = math::min (GAMEWIDTH - this.w )(this.x + this.speed)
    end

    if (Fenster->isKeyDown KEY_SPACE)

        Fenster->rect (this.x + this.w / 2 - 1) (this.y - 1) 3 3 COLOR_WHITE
        if (this.releasedSpace && Fenster.time - this.lastshoot > this.shootDelay)
            bullet = Object::new
            bullet->setClassName "Bullet"
            bullet->spawn (this.x + this.w / 2) (this.y - this.h) true
            Bullets->push bullet
            this.lastshoot = Fenster.time
            Audio->laser
        end
        this.releasedSpace = false
    else
        this.releasedSpace = true
    end

end
-- -----------------------------------------------------------------------------
--      Game Script-Methods
-- -----------------------------------------------------------------------------
fn Game::init this
    this.hiScore = 0
    this.spawnDelay = 100
    this.gameOverTime = 0
    this->reset
    this.gameOver  = true

end

fn Game::gameOver this
    this.gameOverTime = Fenster.time
    Bullets->clear
    this.gameOver = true
    if ( this.score > this.hiScore )
        this.hiScore = this.score
    end
    forRange i enemyCount
--         enemy = Enemies->at i
--         enemy.active = false
        Enemies[i].active = false
    end
end

fn Game::reset this
    this.gameOver  = false
    this.score     = 0
    this.lastSpawn = Fenster.time
    Player->init

end

fn Game::processEnemies this

    doSpawn = Fenster.time - this.lastSpawn >  this.spawnDelay
    forRange i enemyCount
        enemy = Enemies->at i
        if !enemy.active
            if doSpawn
                enemy->spawn
                this.lastSpawn = Fenster.time
                doSpawn = false
            end
        else
            enemy->process
        end
    end
end
-- -----------------------------------------------------------------------------
-- Audio
-- -----------------------------------------------------------------------------
fn Audio::laser this
    this.laser_counter = 0
    this.laserActive = true;
end
fn Audio::explo this
    Audio.explo_counter = 0
    Audio.exploActive = true
end

fn Audio::process this
    n = this.avail
    if n > 0

        forRange i n
            this.counter++

            float_value = 0.0

            -- music

            if Game.gameOver
                t = int::cast (this.counter * soundRate12k)
                music_sample = (((t & t ^ t >> 6 | t * 3) - t  ) & 255) * 0.2
            else
                t = int::cast (this.counter * soundRate8k)
                 music_sample  =  (t*(3+(1^t>>10&5))*(5+(3&t>>14))>>(t>>8&3) & 255) * 0.3
            end
            float_value += music_sample / 255.0



            if this.laserActive
                this.laser_counter++
                lt = int::cast (this.laser_counter * soundRate8k)
--                 laser_sample = ((lt * (64 - (lt >> 7 & 63)) & 128) >> (lt >> 10)) ;
--                 laser_sample = ((lt * (32 - (lt >> 7 & 31)) & 255) >> (lt >> 8)) ;
                laser_sample = ((lt * (16 - (lt >> 2 ))) & 64) >> (lt >> 8) ;
                float_value += laser_sample / 255.0 ;
                if this.laser_counter > 1584
                    this.laserActive = false
                end
            end

            if this.exploActive
                this.explo_counter++
                lt = int::cast (this.explo_counter * soundRate8k)
                explo_sample = ((lt * (lt >> 7 | lt >> 9)) & 128) & (255 >> (lt >> 11));
                float_value += explo_sample / 255.0;

                if this.explo_counter > 2048
                    this.exploActive = false
                end
            end


            -- mix
            this->set i (float_value  * this.vol)
        end
        this->write n
    end
end
-- -----------------------------------------------------------------------------
-- MAIN
-- -----------------------------------------------------------------------------
fn ModuleCreate
    print "--- Fenster Create ---"
    Fenster = Fenster::new title WIDTH HEIGHT SCALE
    if !Fenster; return false;;
--     Fenster.now = Fenster.time



    -- Ship --
    Ship = PixelBuffer::new 16 16
    file = "scripts/modules/ship.tga"
    if (!Ship->load file) print "ERROR: failed to load Ship! must be uncompressed TGA." file; end

    -- Boulder --
    boulder = PixelBuffer::new 16 16
    file = "scripts/modules/boulder1.tga"
    if (!boulder->load file) print "ERROR: failed to load Boulder! must be uncompressed TGA." file; end

    Boulders = Vector::new
    Boulders->push boulder
    d = 0
    while d <= 360.0
        Boulders->push (boulder->cloneRotateFree d)
        d += 15.0;
    end
    boulder = 0

    -- Player --
    Player = Object::new
    Player->setClassName "Player"
    Player->init

    -- Enemies --
    Enemies = Vector::new
    forRange i enemyCount
        enemy = Object::new
        enemy->setClassName "Enemy"
        enemy->init true
        Enemies->push enemy
    end

    -- Stars --
    Stars = Vector::new
    forRange i starCount
        star = Object::new
        star->setClassName "Star"
        star->init true
        Stars->push star
    end

    -- Game --
    Game = Object::new
    Game->setClassName "Game"
    Game->init


    -- Bullets --
    Bullets = Vector::new

    -- Audio --
    Audio   = FensterAudio::new
    Audio->setClassName "Audio"
    Audio.vol   = 0.5
    Audio.rate  = 12000
    Audio.counter = 0
    Audio.laserActive = false
    Audio.laser_counter = 0
    Audio.exploActive = false
    Audio.explo_counter = 0


    return true
end

-- -----------------------------------------------------------------------------
fn ModuleDelete
    print "--- Fenster Delete ---"
    Fenster->close

    -- release the Objects for garbage collection
    Fenster = 0     # The Fenster Object
    Game    = 0
    Player  = 0     # Object
    Bullets = 0     # Vector of Player Bullet Object
    Enemies = 0     # Vector of Enemy Object
    Stars   = 0     # Vector of Stars

    Ship     = 0     # TGA ship :)
    Boulders = 0     # TGA boulder Vector :)

    Audio->close
    Audio    = 0

end
-- -----------------------------------------------------------------------------
fn ModuleLoop
    Fenster->clear backcolor

    -- Stars --
    forRange i starCount
--         star = Stars->at i
--         star->process
        -- 0.7 rocks :)
        Stars[i]->process

    end

    if Game.gameOver
        Fenster->text 90 (GAMEHEIGHT / 2 - 20) "Game over" 4 0xFFFFFF

        if (Fenster.time - Game.gameOverTime > 1000)
            Fenster->text 70 (GAMEHEIGHT / 2 + 30) "press space to restart" 2 0xFFFFFF
            if (Fenster->isKeyDown KEY_SPACE)
                Game->reset
            end
        end

    else
        -- Player
        Player->process

        -- Enemies
        Game->processEnemies

        forRange i Bullets->size
--             bullet = Bullets->at i
--             bullet->process
            Bullets[i]->process
        end
    end

   Fenster->rect 0 GAMEHEIGHT 320 20 0x003000
   Fenster->text 20 (GAMEHEIGHT + 5) (str::format "Score: %04d  Hi: %04d" Game.score Game.hiScore) 2 0xFFFFFF


   Audio->process

   if (!Fenster->loop )|| (Fenster->isKeyDown KEY_ESC)
       return false
   end

   loopCounter++

   return true
end
