-- stdin example
-- socat TCP-LISTEN:12345,fork,max-children=1  system:'./DreiZehn scripts/stdin.13'

import String
import File

log = FileStream::open "stdin.log" "a"
if (!log); error "Failed to open logfile"; return;;
log->writeln "Hello Logfile!"; log->flush

fs = FileStream::open "fs://stdin" "r"
if (!fs); error "Failed to open stream"; return;;

buffer = ""
buffer_size = 255

printraw ">"
while  (buffer = fs->readln buffer_size) != 0
    log->writeln (str::concat "incomming: " buffer); log->flush
    if buffer != ""
        if buffer == "bye" || buffer == "quit"
            break
        end
        printraw "why do you think" buffer "? >"
    else
        printraw ">"
    end
end
fs->close
log->writeln ("-----------------------------------"); log->flush
log->close
fs = 0
log = 0
