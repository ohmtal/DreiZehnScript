-- Byte Code testing

# ------------------------------------------------------------------------------
include "common/FileTools.13" true
# ------------------------------------------------------------------------------
fn niceLine str
    space = 80 - 2 - (str::strlen str)
    if space < 2; print str; return;;
    halfSpace = space / 2
    forRange i halfSpace; printraw "─";;
    printraw " " str " "
    forRange i halfSpace; printraw "─";;
    print ""
end
# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------
niceLine "forRange"
debug::bc 'forRange i 10; printraw "**" i "**";;print " <<<"'
return
# ------------------------------------------------------------------------------
niceLine "call C Func print"
debug::bc 'print "Hello World!"'

define foo = 47.11;
global b = 20;

# ------------------------------------------------------------------------------
niceLine "local, global, define, consts"
debug::bc 'b = 78;a= 10.1;print "Local 10.1?" a "Global 78?" b ", CONST 1?:" true "DEFINE 47.11?" foo';
print "should be 78:" b
# ------------------------------------------------------------------------------
niceLine "basic math,  return"
debug::bc 'a = 4; b = 3; (print a "+" b " = " a + b )'
debug::bc 'a = 4; b = 3; (print a "-" b " = " a - b )'
debug::bc 'a = 4; b = 3; (print a "*" b " = " a * b )'
debug::bc 'a = 4; b = 3; (print a "/" b " = " a / b )'

debug::bc 'a = 4.0; b = 3.0; (print a "+" b " = " a + b )'
debug::bc 'a = 4.0; b = 3.0; (print a "-" b " = " a - b )'
debug::bc 'a = 4.0; b = 3.0; (print a "*" b " = " a * b )'
debug::bc 'a = 4.0; b = 3.0; (print a "/" b " = " a / b )'

debug::bc 'a = "Hello "; b = "World"; (print a "+" b " = " a + b )'

debug::bc "return math::randomf"
# ------------------------------------------------------------------------------
niceLine "forRange"
-- debug::bc 'forRange i 10; ;;print " <<<"'
debug::bc 'forRange i 10; printraw i ; printraw "**";;print " <<<"'


fn runVarTest
    ft = FileTool::new "scripts/test_simplevar.13"
    ft->load
    debug::bc ft.content
end

