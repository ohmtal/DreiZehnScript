# Benchmark-Test for DreiZehn Script (0.8)
-- import Core
-- import Math

define JLOOPS 25
define ILOOPS 1000000
define HLOOPS ILOOPS / 2

global varX = 0.0; type = "GLOBAL"
-- varX = 0.0; type = "LOCAL"


forRange j JLOOPS
    forRange i ILOOPS
        varX += 1.0
    end
    print  "SUM (++) IS: " varX
    forRange i ILOOPS
        varX -= 1.0
    end
    print  "SUM (--) IS: " varX

    varX = 66.0
    print  "set Sum to 66 == " varX

    for i 0 (ILOOPS - 1)
         varX *=  i + 1
         varX /=  i + 1
    end
    print  "SUM (*/ %i+1) IS: " varX

    forRange i HLOOPS
        ran = math::randomf * i
        varX -= ran
        varX += ran
    end
    print  "last ran" ran
    print  "SUM (rand +-) IS: " varX
end


varX = varX - 33.0
print "---------------------"
print "  *** " type " ***"
print "---------------------"
print " VAR TYPE IS:" core::getTypeName varX
print  " Final sum should be 33.0 == " varX
print "---------------------"
if type != "GLOBAL"; print " ... use parameter global for global test ...\n";;
