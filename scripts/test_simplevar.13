# Benchmark-Test for DreiZehn Script (0.8)
-- import Core
-- import Math

define JLOOPS 25
define ILOOPS 1000000
define HLOOPS ILOOPS / 2

if (sys::args->count > 2 && (sys::args->value 2) == "global")
    global varX = 0.0; type = "GLOBAL"
else
    varX = 0.0; type = "LOCAL"
end

forRange j JLOOPS
    forRange i ILOOPS
        varX++
    end
    print  "SUM (++) IS: " varX
    forRange i ILOOPS
        varX--
    end
    print  "SUM (--) IS: " varX

    varX = 66
    print  "set Sum to 66 == " (varX * 1)

    forRange i ILOOPS
        varX = varX * (i + 1)
        varX = varX / (i + 1)
    end
    print  "SUM (*/ %i+1) IS: " varX

    ran = 0.0
    forRange i HLOOPS
        ran = math::randomf * i
        varX = varX - ran
        varX = varX + ran
    end
    print  "last ran" ran
    print  "SUM (rand +-) IS: " varX
end

varX = varX - 33.0
print "---------------------"
print "  *** " type " ***"
print "---------------------"
print  "Final sum should be 33.0 == " varX
print "---------------------"
print " ... use parameter global for global test ...\n"
