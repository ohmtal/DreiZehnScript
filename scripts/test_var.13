# Benchmark-Test for DreiZehn Script (0.4)
JLOOPS = 25
ILOOPS = 1000000

globalX = 0

for j 0 (JLOOPS - 1)
    for i 0 (ILOOPS - 1)
        globalX++
    end
    print  "SUM (++) IS: " globalX

    for i 0 (ILOOPS - 1)
        globalX--
    end
    print  "SUM (--) IS: " globalX

    globalX = 66
    print  "set Sum to 66 == " (globalX * 1)

    for i 0 (ILOOPS - 1)
        globalX *= (i + 1)
        globalX /= (i + 1)
    end
    print  "SUM (*/ %i+1) IS: " globalX

    limit = (ILOOPS / 2) - 1
    ran = 0.0
    for i 0 limit
        ran = math:randomf * i
        globalX -= ran
        globalX += ran
    end
    print  "last ran" ran
    print  "SUM (rand +-) IS: " globalX
end

globalX = globalX - 33
print "---------------------"
print "---------------------"
print  "Final sum should be 33 == " globalX
print "---------------------"
print "---------------------"
