# Benchmark-Test for DreiZehn Script (0.4)
JLOOPS = 25
ILOOPS = 1000000

localX = 0

for j 0 (JLOOPS - 1)
    for i 0 (ILOOPS - 1)
        localX++
    end
    print  "SUM (++) IS: " localX

    for i 0 (ILOOPS - 1)
        localX--
    end
    print  "SUM (--) IS: " localX

    localX = 66
    print  "set Sum to 66 == " (localX * 1)

    for i 0 (ILOOPS - 1)
        localX *= (i + 1)
        localX /= (i + 1)
    end
    print  "SUM (*/ %i+1) IS: " localX

    limit = (ILOOPS / 2) - 1
    ran = 0.0
    for i 0 limit
        ran = math:randomf * i
        localX -= ran
        localX += ran
    end
    print  "last ran" ran
    print  "SUM (rand +-) IS: " localX
end

localX = localX - 33
print "---------------------"
print "---------------------"
print  "Final sum should be 33 == " localX
print "---------------------"
print "---------------------"
