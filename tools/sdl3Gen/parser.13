-- -----------------------------------------------------------------------------
args = sys::args
filename = args.argv_2
if (filename == "" || filename == 0)
    error "USAGE: DreiZehn parser.13 SDL_filename.h"
    error "EXAMPLE: DreiZehn parser.13 SDL_rect.h"
    return 1
end

fn rl
    run args.argv_1
end

-- -----------------------------------------------------------------------------
strSep = "\""

Tokens = Vector::new
-- {"file":"SDL_stdinc.h",
filter = str::concat "{" strSep "file" strSep ":" strSep filename strSep ','

-- -----------------------------------------------------------------------------

-- -----------------------------------------------------------------------------
fn Parser::advance this
    cur = this->peek
    this._index_ ++;
    if this._index_ > this._len_ return "";;
    return cur
end

fn Parser::peek this
    return this._line_[this._index_]
end

-- -----------------------------------------------------------------------------
-- {"file":"SDL_rect.h","kind":"function","name":"SDL_GetRectAndLineIntersectionFloat","return_type":"int","params":[{"name":"rect","type":"const SDL_FRect *"},{"name":"X1","type":"float *"},{"name":"Y1","type":"float *"},{"name":"X2","type":"float *"},{"name":"Y2","type":"float *"}]}
-- -----------------------------------------------------------------------------
fn Parser::parse this
    curlyPos = 0
    squarePos = 0

    str = ""
    left = ""
    token = 0

    this.parent = 0
    curVector = this

    while this->peek != ""
        startindex = this._index_

        if this->peek == "{"
            this->advance
            curlyPos ++
            token = Object::new
            curVector->push token
        end

        if this->peek == "}"
            this->advance
            curlyPos --
            if (curlyPos < 0); error "Parse error to many curly close!"; return 0;;
            token = this->at curlyPos
        end

        if this->peek == "["
            this->advance
            squarePos++
            newVector = Vector::new
            newVector.parent = curVector
            curVector = newVector
            token->setField left curVector
            left = ""
        end
        if this->peek == "]"
            this->advance
            squarePos--
            curVector = curVector.parent
            if (squarePos < 0); error "Parse error to many square close!"; return 0;;
        end

        if (this->peek == strSep)
            this->advance
            tmpStr = ""
            while this->peek != strSep && this->peek != ""
                tmpStr += this->advance
            end
            if (left == "") left = tmpStr
            else token->setField left tmpStr; left = "";;
--             print "str is >>" tmpStr "<<, left is >>" left "<<"
            if (this->peek == "") return;;
            this->advance
        end

        if (this->peek == ":")
            this->advance
            -- left is set before ...
        end

        if (this->peek == ",")
            this->advance
            -- left is set before ...
        end




        if startindex == this._index_; error "PARSE ERROR peek not moved!"; return 0;;
    end
end


fn parseLine line
    log->writeln (str::concat "LINE: " line); log->flush
    pos = (str::strstr line filter)
    if pos != 0; return 0 ;;


    parser = Vector::new
    parser->setClassName "Parser"
    parser._line_ = line
    parser._len_ = str::strlen line
    parser._index_ = 0
    parser->parse

--     parser->dump


    return parser
end
-- -----------------------------------------------------------------------------
fn ToToken tokenvector


    forEach token tokenvector
        if (token.kind == "param")
            print "SKIP PARAM: " token.function token.name
        elif (token.kind == "struct_field")
            structname = token.struct
            field = Tokens->getField structname
            if (field && field->getType == TypeObject  )
                if (field.params && field.params == TypeVector)
                    print "ADD " token "TO" structname
                    field.params->push token
                else
                    print "add " token "TO NEW "  structname ".params"
                    field->setField "params" Vector::new
                    field.params->push token
                end
            else
                print "DID NOT FIND" structname "LET SEE IN AFTER PARSE!"
                Tokens->push token
            end

        else

            if token.name
                Tokens->setField token.name token
            else
                -- push unknown
                Tokens->push token
            end
        end
    end

end
-- -----------------------------------------------------------------------------
fn readLoop

    while  (buffer = fs->readln buffer_size) != 0
        if buffer != ""
            curParsed = parseLine buffer
            if (curParsed)
                ToToken curParsed
            end
        end
    end
end
-- -----------------------------------------------------------------------------
fn createStruct dummy;;###forward

fn TokensTree
    Tokens->dump
    count = Tokens->getFieldCount

    forRange i count
        token = Tokens->getField i
        print "----------------------" (Tokens->getFieldName i) "------------------------------"
        forRange j token->getFieldCount
            print "    " (token->getFieldName j) "=" (token->getField j)
        end
        forEach subToken token.params
            forRange j subToken->getFieldCount
                print "          " (subToken->getFieldName j) "=" (subToken->getField j)
            end
            print "          ...."
        end

        if (token.kind == "struct"); print (createStruct token);;
    end


    if (Tokens->size > 0)
        error "------------------------------------------------------------------------------"
        error "        WE STILL HAVE " Tokens->size " TOKENS IN THE BAG!!!!"
        error "------------------------------------------------------------------------------"
    end
end
-- -----------------------------------------------------------------------------

REGISTER_STR = "\n\n"

getFieldSetFieldStr = "   inline virtual bool onGetField(uint32_t fieldSymbolId, Value& ret) override { \n"
getFieldSetFieldStr +="      Value* ptr = onGetFieldPtr(fieldSymbolId);\n"
getFieldSetFieldStr +="      if (ptr) { ret = *ptr; return true; }\n"
getFieldSetFieldStr +="      return false;\n"
getFieldSetFieldStr +="   }\n"
getFieldSetFieldStr +="\n"
getFieldSetFieldStr +="   inline virtual bool onSetField(uint32_t fieldSymbolId, const Value& value) override {\n"
getFieldSetFieldStr +="       Value* ptr = onGetFieldPtr(fieldSymbolId);\n"
getFieldSetFieldStr +="       if (ptr) { *ptr = value; return true; }\n"
getFieldSetFieldStr +="       return false;\n"
getFieldSetFieldStr +="   }\n"
getFieldSetFieldStr +="\n"
-- -----------------------------------------------------------------------------
fn createStruct tokenObject
    result = ""
    objname  = str::format "%sObject" tokenObject.name
    typename = str::format "Type%s" objname

    -- register type
    result += str::format "const int %s =  RegisterUserObjectType(\"%s\");\n" tokenObject.name
    result += "\n"
    -- create struct
    result += str::format "struct %s : public ValueObject {\n" objname
    -- values and data
    forEach param tokenObject.params
        result += str::format "   Value m%s;" param.field
        result += str::format " inline static ValueObjectProperty m%sProp;\n" param.field
    end
    result += str::format "   %s mData = {0}; \n" tokenObject.name
    result += "\n"

    -- constructor
    result += str::format "   %s(): ValueObject(%s) {\n" objname typename
    result += "      mSupportClone = true;\n"
    result += "   }\n"

    -- clone
    result += "   virtual ValueObject* clone() override {\n"
    result += str::format "      %s* clone = new %s();\n" objname objname
    result += "      ValueObject::cloneBase(clone);
    forEach param tokenObject.params
        result += str::format "         clone->m%s = this->m%s;\n" param.field param.field
    end
    result += "      return clone;\n"
    result += "   }\n"

    -- dataPrt
    result += str::format "   inline virtual %s* dataPtr()  {\n" tokenObject.name
    forEach param tokenObject.params
        result += str::format "      mData.%s = (%s)m%s.getDouble();\n" param.field param.type param.field
    end
    result += "      return &mData;\n"
    result += "   }\n"

    -- data
    result += str::format "   inline virtual const %s& data()  {\n" tokenObject.name
    forEach param tokenObject.params
    -- FIXME not allways getDouble!!
        result += str::format "      mData.%s = (%s)m%s.getDouble();\n" param.field param.type param.field
    end
    result += "      return mData;\n"
    result += "   }\n"


    -- onGetFieldPtr
    result += "   inline virtual Value* onGetFieldPtr(uint32_t fieldSymbolId) override {\n"
        forEach param tokenObject.params
            result += str::format \
                "        if (fieldSymbolId == m%sProp.mSymbolId) return &m%s;\n" \
                param.field param.field
        end
        result += "      return ValueObject::onGetFieldPtr(fieldSymbolId);\n"
        result += "   }\n"
    }

    -- other getter/setter
    result += getFieldSetFieldStr

    -- symbols
    result += "\n"
    result += "   inline static void RegisterSymbols() {\n"
    result += "   static bool mSymbolsLoaded = false;\n"
    result += "   if (mSymbolsLoaded) return ;\n"
    forEach param tokenObject.params
        result += str::format "      m%sProp = ValueObjectProperty(\"%s\",\"\",%s) ;\n" \
                param.field param.field typename
    end
    result += "      mSymbolsLoaded = true;\n   }\n"

    result += "\n};\n"

    -- --------------------------
    REGISTER_STR += str::format "%s::RegisterSymbols();\n" objname
    REGISTER_STR += str::format "RegisterFunction(\"%s\", [](std::vector<Value>& args, Value& ret) -> bool {\n" \
            tokenObject.name
    REGISTER_STR += str::format "   %s* obj= new %s();\n" objname objname
    iter = 0
    forEach param tokenObject.params
        -- FIXME not always getDouble!!
        REGISTER_STR += str::format "   if (args.size() > %d) obj->m%s = args[%d].getDouble();\n" \
                iter  param.field iter
        iter++
    end
    REGISTER_STR += "   ret = Value(obj);\n"
    REGISTER_STR += "   return true;\n"
    REGISTER_STR += "});\n"



    return result
end
