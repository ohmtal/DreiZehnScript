-- ~~~~~

log = FileStream::open "parser.log" "w"
if (!log); error "Failed to open logfile"; return;;
log->writeln "start parsing..."; log->flush

fs = FileStream::open "fs://stdin" "r"
if (!fs); error "Failed to open stream"; return;;

buffer = ""
buffer_size = 255

line = "{\"file\":\"SDL_rect.h\",\"kind\":\"function\",\"name\":\"SDL_GetRectAndLineIntersectionFloat\",\"return_type\":\"int\",\"params\":[{\"name\":\"rect\",\"type\":\"const SDL_FRect *\"},{\"name\":\"X1\",\"type\":\"float *\"},{\"name\":\"Y1\",\"type\":\"float *\"},{\"name\":\"X2\",\"type\":\"float *\"},{\"name\":\"Y2\",\"type\":\"float *\"}]}"

parsedLine = parseLine line
while core::breath; core::sleep 16;;


-- -- readLoop


fs->close
log->close
fs = 0
log = 0
