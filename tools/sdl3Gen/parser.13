Tokens->dump
print ".............. POST PROCESS ..................."
ToToken Tokens

print "..............TOKEN TREE ..................."
TokensTree

print ".............. REGISTER_STR ..................."
print REGISTER_STR

print ".............. REGISTER_CONST ..................."
print REGISTER_CONST

fs->close
log->close
fs = 0
log = 0
