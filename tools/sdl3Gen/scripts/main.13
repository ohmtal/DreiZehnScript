import All
include "../../common/FileTools.13" true
include "../../common/JSONParser.13" true
include "scripts/sourceGen.13" false
include "scripts/tokens.13" true
-- -----------------------------------------------------------------------------
if sys::args->count < 3
    error "missing parameter Usage: main.13 SDL_File.h"
    return false
end
-- -----------------------------------------------------------------------------
jsonFilename = str::concat "json/" (sys::args->value 2)  ".json"
print "** loading " jsonFilename
fileTool = FileTool::new jsonFilename
fileTool->load
if fileTool.content == ""; error "Failed to load " jsonFilename; return; end
# print "*** CONTENT:" fileTool.content; return;
-- -----------------------------------------------------------------------------
--  last boolean is debug flag
print "** start json parser ....."
parser = Parser::new fileTool.content false
parser->dump
print "** start tokens ....."
tokenWorker  = Tokens::new parser true

-- -----------------------------------------------------------------------------
--  TEST with CONSOLE
-- -----------------------------------------------------------------------------
global doReload = false
fn postRL; doReload = false if sys::args->count > 1; run (sys::args->value 1) ;; end
fn rl; doReload = true;;
-- -----------------------------------------------------------------------------
-- while core::breath && !doReload; core::sleep 16; end; if (doReload) postRL;;
