import All



-- -----------------------------------------------------------------------------
fn Tokens::debug this p1 p2 p3 p4 p5
    if this._debug_
        if p1==0 p1 ="";; if p2==0 p2 ="";; if p3==0 p3 ="";; if p4==0 p4 ="";;
        if p5==0 p5 ="";;
        print (str::format "PARSER DEBUG: %s %s %s %s %s" p1 p2 p3 p4 p5 )
    end
end
-- -----------------------------------------------------------------------------
fn Tokens::run this jsonTree

    forEach token jsonTree
        if (token.kind == "param")
            this->debug "SKIP PARAM: " token.function token.name
        elif (token.kind == "struct_field")
            structname = token.struct
            field = this->getField structname
            if (field && field->getType == TypeObject  )
                if (field.params && field.params->getType == TypeVector)
                    if this._debug_; print "add >>>>" token "<<<<< to" structname;;
--                     this->debug "ADD " (token) "TO" structname
                    field.params->push token
                else
                    if this._debug_; print "add >>>>" token "<<<<< to" structname;;
--                     this->debug "add " (token) "TO NEW "  structname ".params"
                    field->setField "params" Vector::new
                    field.params->push token
                end
            else
                this->debug "DID NOT FIND" structname "LET SEE IN AFTER PARSE!"
                this->push token
            end

        else

            if token.name
                this->setField token.name token
            else
                -- pus"h unknown
                this->push token
            end
        end
    end

end

-- -----------------------------------------------------------------------------
fn Tokens::generateSource this
    this->dump
    count = this->getFieldCount

    forRange i count
        fieldName = this->getFieldName i
        if (fieldName == "_debug_") continue;;
        this->debug "----------------------" fieldName "------------------------------"
        token = this->getField i

        varType = getType token
        if varType != type::object
            this->debug "UNKNOWN TOKEN" token
            continue
        end

        forRange j token->getFieldCount
            this->debug "    " (token->getFieldName j) "=" (token->getField j)
        end
        if (token.kind == "constant_macro")
        else

            forEach subToken token.params
                forRange j subToken->getFieldCount
                    this->debug "          " (subToken->getFieldName j) "=" (subToken->getField j)
                end
                this->debug "          ...."
            end
        end

--         if (token.kind == "struct"); print(createStruct token)
--         elif (token.kind == "constant_macro") print(createConst token)
        if (token.kind == "struct"); createStruct token
        elif (token.kind == "constant_macro") createConst token
        else this->debug "================ TODO:" token.kind token.name" =========================="
        end
    end


    if (this->size > 0)
        error "------------------------------------------------------------------------------"
        error "        WE STILL HAVE " this->size " TOKENS IN THE BAG!!!!"
        error "------------------------------------------------------------------------------"
    end
end

-- -----------------------------------------------------------------------------
fn Tokens::new jsonTree debug
    this = Vector::new
    this->setClassName "Tokens"
    this._debug_ = debug
    this->run jsonTree
    this->generateSource
    return this
end



